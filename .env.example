# Copy this file to .env and fill in what you need. .env is never committed.

# Turns on the real AI quote builder. Leave blank for demo mode (built-in estimator).
ANTHROPIC_API_KEY=
# Optional: which Claude model to use for quotes. Blank = claude-opus-5-5.
# claude-haiku-5-5 is much cheaper and faster, at some cost to accuracy.
ANTHROPIC_MODEL=
# Optional: most real AI quotes per day (a spending backstop). Default 100.
AI_DAILY_LIMIT=

# Optional: the web address customers' links start with, e.g. https://quotes.example.com.
# Leave blank to use the address you're browsing on (Render sets its own automatically).
PUBLIC_URL=

# Long random string used to sign things. Any value works for the demo.
SESSION_SECRET=change-me

# Hosted site only: private passwords (12+ characters) that replace the demo ones
# and hide them from the login page. Required if ANTHROPIC_API_KEY is set in production.
OWNER_PASSWORD=
AGENCY_PASSWORD=

# API port (the web app runs on 5173 in development and forwards /api here).
PORT=3001
